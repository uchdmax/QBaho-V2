generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Rating {
  id             Int      @id @default(autoincrement())
  department     String
  respondentType String? // 'PATIENT' | 'PARENT' | 'SPOUSE' | 'RELATIVE'
  overallScore   Int?
  audioUrl       String?
  comment        String?
  phone          String?
  status         String   @default("NEW")
  createdAt      DateTime @default(now())

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  values RatingValue[]
}

model RatingValue {
  id          Int       @id @default(autoincrement())
  ratingId    Int
  rating      Rating    @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  criterionId Int
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score       Int
  textAnswer  String?
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Employee {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  position  String? // e.g. 'Shifokor', 'Hamshira'
  imageUrl  String? // Optional profile picture
  createdAt DateTime @default(now())

  ratings       Rating[]
  departmentRel Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  departmentId  Int?
}

model Criterion {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  options   String?
  createdAt DateTime @default(now())

  departments  Department[]
  ratingValues RatingValue[]
}

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. 'reception', 'kassa', '3-qavat'
  name      String
  type      String // 'general' or 'floor'
  floor     Int? // optional floor number for floor type
  icon      String? // optional icon name for frontend
  color     String? // optional Tailwind color class for frontend
  bg        String? // Tailwind bg class, e.g., 'bg-blue-100'
  order     Int? // For ordering departments
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Parent-Child hierarchy (Universal for any department)
  parentId Int?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  // Relations
  employees Employee[]  @relation("DepartmentEmployees")
  criteria  Criterion[]
}
